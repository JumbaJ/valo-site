{
  "crons": [
    {
      "path": "/api/epoch-payout",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/creator-cycle",
      "schedule": "30 9 * * *"
    }
  ],
  "functions": {
    "api/epoch-payout.js": {
      "maxDuration": 120
    },
    "api/creator-cycle.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/t/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/t/(.*)",
      "destination": "/index.html"
    }
  ]
}
